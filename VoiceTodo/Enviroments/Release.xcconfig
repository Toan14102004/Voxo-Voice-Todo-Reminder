APP_NAME = VoiceTodo
APP_ENV = Release
// TODO: replace with the real values once App Store Connect / legal pages exist for this app.
APP_ID = REPLACE_WITH_YOUR_APP_STORE_ID
PRIVACY_URL = https:\/\/REPLACE_WITH_YOUR_PRIVACY_POLICY_URL
TERM_OF_USE_URL = https:\/\/REPLACE_WITH_YOUR_TERMS_URL
EMAIL_FEEDBACL = REPLACE_WITH_YOUR_SUPPORT_EMAIL
ADJUST_TOKEN = REPLACE_WITH_YOUR_ADJUST_TOKEN
ADJUST_PURCHASE_TOKEN = REPLACE_WITH_ADJUST_PURCHASE_EVENT_TOKEN
FACEBOOK_APP_ID = 000000000000000
FACEBOOK_CLIENT_TOKEN = REPLACE_WITH_YOUR_FACEBOOK_CLIENT_TOKEN
TIKTOK_APP_ID = REPLACE_WITH_TIKTOK_APP_ID
TIKTOK_ACCESS_TOKEN = REPLACE_WITH_TIKTOK_ACCESS_TOKEN
