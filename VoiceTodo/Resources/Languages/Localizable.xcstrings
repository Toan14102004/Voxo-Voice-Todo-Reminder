    "Help us to make a better experience for you!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعدنا في تقديم تجربة أفضل لك!"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার জন্য আরও ভালো অভিজ্ঞতা তৈরি করতে আমাদের সাহায্য করুন!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
